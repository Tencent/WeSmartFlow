# 复制此文件到仓库根目录的 .env 并填入真实值（注意：.env 放在仓库根，不在 backend/ 下）
# cp backend/.env.example .env

# ============================================================
# LLM 配置（OpenAI 兼容协议）
# ============================================================

LLM_API_KEY=""          # sk-your-key-here
LLM_BASE_URL=""         # https://api.openai.com/v1
LLM_MODEL=""            # gpt-4o
# LLM_CONTEXT_WINDOW=   # 可选：模型上下文窗口（token）。留空则按模型名自动推断；
#                       # 推断不出时不做裁剪。装配层会扣除 system 与工具 schema
#                       # 的开销，把剩余预算下发给记忆用于裁剪历史。
# PROFILE_LLM_MODEL=""  # 可选：画像提取/编译专用模型，建议 deepseek-chat 等 tool_call 稳定模型

# ============================================================
# 图像生成（OpenAI 兼容协议）
# ============================================================

IMG_API_KEY=""          # sk-your-key-here
IMG_MODEL=""            # gpt-image-1
IMG_BASE_URL=""         # https://api.openai.com/v1

# ============================================================
# 通用配置
# ============================================================

# Tavily 搜索
TAVILY_API_KEY=""       # tvly-xxx
# TAVILY_BASE_URL=""    # 可选：Tavily 兼容服务地址（SDK 拼接 /search），留空为官方地址；
#                       # 仅作用于平台 Key，用户自配 Key 始终走官方地址。
#                       # 计价不同时用 PRICING_OVERRIDES_JSON 覆盖 "search:tavily"（元/credit）
ANYSEARCH_API_KEY=""

# 语音合成：OpenAI 兼容 /audio/speech（可选；三项全部留空则沿用 DashScope qwen3-tts）
# 配置任意一项后必须三项齐全；用户在设置页自配的 DashScope Key 仍优先。
# TTS_API_KEY=""
# TTS_BASE_URL=""       # 例如 https://api.openai.com/v1（客户端拼接 /audio/speech）
# TTS_MODEL=""          # 例如 tts-1
# TTS_VOICE=""          # 可选：默认音色
# TTS_SPEED=            # 可选：语速倍率

# 服务配置（可选，有默认值）
# 默认只监听本机回环地址。需要局域网/公网访问时显式改为 0.0.0.0，
# 并确保前面有反向代理/防火墙，不要把 8080 直接暴露到公网。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 对外可访问的后端地址，用于微信通道发给用户的文档链接（链接只带单文档、24 小时有效的票据）
# PUBLIC_BASE_URL=https://your.domain

# 前端 dev server（Vite）默认只监听 127.0.0.1，因为它会把 /api 代理到本机后端。
# 局域网/手机调试时再临时指定：VITE_DEV_HOST=0.0.0.0 npm run dev
# examples/live_science 同理：LIVE_SCIENCE_HOST=0.0.0.0 python server.py

# JWT 主密钥（HS256，至少 32 个随机字符）
# 留空：启动时自动生成 48 字节随机密钥并保存到 data/jwt_secret.key（权限 0600）。
# 显式配置：使用随机串，例如
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意：历史示例值（change-me-in-production 等）会被拒绝启动；
# 该密钥是登录 token 的唯一信任根，不要提交到仓库或写进镜像。
JWT_SECRET=
# JWT_SECRET_FILE=data/jwt_secret.key   # 可选：自动生成密钥的保存位置
JWT_EXPIRE_HOURS=72

# Admin 审核台账号（可选；未配置时所有 /api/admin 接口返回 503）
# 请使用强口令，并定期轮换（轮换后旧 admin token 立即失效）。
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_TOKEN_EXPIRE_HOURS=12

# 免费额度配置（每用户总量，用完即止）
FREE_LLM_TOTAL=100       # LLM 调用总次数
FREE_SEARCH_TOTAL=30     # 搜索总次数
FREE_IMAGE_TOTAL=15      # 图片生成总次数

# ============================================================
# 认证配置（至少配置一种登录方式）
# ============================================================

# SMTP 邮件配置（邮箱验证码登录）
SMTP_HOST=""            # smtp.qq.com
SMTP_PORT=465
SMTP_USER=""            # 发件邮箱
SMTP_PASSWORD=""        # SMTP 授权码
SMTP_FROM_NAME="WeSmartFlow"

# 微信小程序配置（扫码登录）
WECHAT_MP_APPID=""
WECHAT_MP_SECRET=""

# GitHub OAuth 配置
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ============================================================
# 内容安全审核（可选，体验站建议开启）
# ============================================================

CONTENT_GUARD_ENABLED=false                  # 是否启用内容审核（true/false）
CONTENT_GUARD_LLM_ENABLED=true               # 是否启用 LLM 语义审核（默认 true，需先启用上面的开关）
# CONTENT_RULES_PATH=config/content_rules.yaml   # 规则文件路径
# CONTENT_GUARD_LLM_MODEL=                       # 语义审核用的模型（默认用 LLM_MODEL，建议用轻量模型）

# ============================================================
# 知识图谱（KG，内嵌运行，基于 sqlite-vec）
# ============================================================

# 数据目录（默认仓库根 ./data）
# KG_DATA_DIR=
# KG_DB_FILE=kg.db

# 向量库（sqlite-vec，单文件，多进程友好；无需独立服务）
# KG_VEC_DB_FILE=kg_vec.db
# KG_VEC_DB_PATH=         # 留空则使用 KG_DATA_DIR/KG_VEC_DB_FILE

# Embedding（强烈建议配置；不配则 KG 退化为纯 FTS，召回效果大幅下降）
KG_EMBEDDING_API_KEY=""
KG_EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
KG_EMBEDDING_MODEL="text-embedding-v4"
KG_EMBEDDING_DIM=1024
# 单批条数（1-100）。DashScope text-embedding-v4 上限 10；OpenAI 系
# （text-embedding-3-*）可放大到 50：关系 probe 表 49 条文本由 5 次串行请求
# 降为 1 次（p6n 实测 13.9s → 3.4s）。
KG_EMBEDDING_BATCH=10
# 供应商支持 dimensions 参数时置 1（如 text-embedding-3 系列默认 3072 维，需压到 KG_EMBEDDING_DIM）
KG_EMBEDDING_SEND_DIMENSIONS=0
# Embedding 调用使用系统平台 Key，不占用户积分；超时后的上游计费状态不明确，
# 因此默认不自动重试。只有供应商提供幂等键后才应改变该策略。
# PROVIDER_OPENAI_COMPATIBLE_EMBEDDING_TIMEOUT_SECONDS=30
# Chat 前置 KG 检索预算（毫秒）。检索含一次 embedding 往返，
# embedding 为远程服务时建议 >= 5000，超时则跳过本轮 KG 注入。
# KG_CHAT_PRERAG_TIMEOUT_MS=5000
